{
  "manifest_version": 3,
  "name": "Lock In Bro",
  "version": "0.1.0",
  "description": "Lock in now. Scroll later. Block only the sites you choose.",
  "permissions": [
    "storage",
    "alarms",
    "declarativeNetRequestWithHostAccess"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.css",
        "blocked.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ]
}
